use('mflix');

//Ej. 1

db.runCommand({
    collMod: "users",
    validator: {
        $jsonSchema: {
            bsonType: "object",
            required: ["name", "email","password"],
            properties: {
                name: {
                    bsonType: "string",
                    maxLength: 30,
                },
                email: {
                    bsonType: "string",
                    pattern: "^(.*)@(.*)\\.(.{2,4})$"
                },
                password: {
                    bsonType: "string",
                    minLength: 50
                }
            }
        }
    }
});

