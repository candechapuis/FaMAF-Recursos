//Ej. 3

db.runCommand(
    {
        collMod: "theaters",
        validator: {
            $jsonSchema: {
                bsonType: "object",
                required: ["theaterId", "location"],
                properties: {
                    theaterId: {
                        bsonType: "int"
                    },
                    location: {
                        bsonType: "object",
                        required: ["address"],
                        properties: {
                            address: {
                                bsonType: "object",
                                required: [
                                    "street1", 
                                    "city", 
                                    "state",
                                    "zipcode"
                                ],
                                properties: {
                                    street1: {
                                        bsonType: "string"
                                    },
                                    city: {
                                        bsonType: "string"
                                    },
                                    state: {
                                        bsonType: "string"
                                    },
                                    zipcode: {
                                        bsonType: "string"
                                    },
                                }
                            },
                            geo: {
                                bsonType: "object",
                                properties: {
                                    type: {
                                        enum: ["Point", null],
                                    },
                                    coordinates: {
                                        bsonType: "array",
                                        items: [
                                            {
                                                bsonType: "double"
                                            },
                                        ],
                                        minItems: 2,
                                        maxItems: 2
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        validationAction: "warn"
    } 
);

