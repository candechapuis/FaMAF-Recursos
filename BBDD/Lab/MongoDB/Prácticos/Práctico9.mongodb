//Ej. 4

db.runCommand({
    collMod: "movies",
    validator: {
        $jsonSchema: {
            bsonType: "object",
            required: ["title", "year"],
            properties: {
                title: {
                    bsonType: "string"
                },
                year: {
                    bsonType: "int",
                    minimum: 1900,
                    maximum: 3000
                },
                cast: {
                    bsonType: "array",
                    items: {
                        bsonType: "string"
                    },
                    uniqueItems: true,
                },
                directors: {
                    bsonType: "array",
                    items: {
                        bsonType: "string"
                    },
                    uniqueItems: true,
                },
                countries: {
                    bsonType: "array",
                    items: {
                        bsonType: "string"
                    },
                    uniqueItems: true,
                },
                genres: {
                    bsonType: "array",
                    items: {
                        bsonType: "string"
                    },
                    uniqueItems: true,
                }
            }
        }
    }
});

