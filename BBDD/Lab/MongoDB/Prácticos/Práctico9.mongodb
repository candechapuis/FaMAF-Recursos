// Ej. 5

db.createCollection("userProfile", 
    {
        validator: {
            $jsonSchema: {
                bsonType: "object",
                required: ["user_id", "language"],
                properties: {
                    user_id: {
                        bsonType: "objectId"
                    },
                    language: {
                        enum: ["English", "Spanish", "Portuguese"]
                    },
                    favorite_genres: {
                        bsonType: "array",
                        items: {
                            bsonType: "string"
                        },
                        uniqueItems: true,
                    }
                }
            }
        }

    }
);

//valid documents
db.userProfile.insertMany([
    {user_id: ObjectId('6902331d30f9226e2b80b097'), language: "Spanish"},
    {user_id: ObjectId('6902341f30a7886e2b80b092'), language: "Spanish", favorite_genres: ["Suspense"]}
]);

//invalid documents

// requirements fail (user_id missing)

db.userProfile.insertOne(
    {language: "Spanish"},
);

// duplicated value in array

db.userProfile.insertOne(
    {user_id: ObjectId('55555777ddde6fa7cb7a889a'), language: "Spanish", favorite_genres: ["Suspense", "Suspense"]}
);

// Ej. 6

use('shop');

db.createCollection("books",
    {
        validator: {
            $jsonSchema: {
                bsonType: "object",
                required: ["book_id", "title", "author", "price"],
                properties: {
                    book_id: {
                        bsonType: "int"
                    },
                    title: {
                        bsonType: "string",
                        maxLength: 70
                    },
                    author: {
                        bsonType: "string",
                        maxLength: 70
                    },
                    price: {
                        bsonType: "double"
                    },
                    categories: {
                        bsonType: "array",
                        items: {
                            bsonType: "string"
                        },
                        uniqueItems: true
                    }
                }
            }
        }
    }
);

db.createCollection("orders",
    {
        validator: {
            $and: [
                {
                    $jsonSchema: {
                        bsonType: "object",
                        required: ["order_id", "delivery_address", "detail"],
                        properties: {
                            order_id: {
                                bsonType: "int"
                            },
                            delivery_name: {
                                bsonType: "string",
                                maxLength: 70
                            },
                            delivery_address: {
                                bsonType: "string",
                                maxLength: 70
                            },
                            cc_name: {
                                bsonType: "string",
                                maxLength: 70
                            },
                            cc_number: {
                                bsonType: "string",
                                maxLength: 32
                            },
                            cc_expiry: {
                                bsonType: "string",
                                maxLength: 20
                            },
                            detail: {
                                bsonType: "array",
                                items: {
                                    bsonType: "object",
                                    required: ["book_id","quantity", "price", "total_price"],
                                    properties: {
                                        book_id: {
                                            bsonType: "int"
                                        },
                                        quantity: {
                                            bsonType: "int"
                                        },
                                        price: {
                                            bsonType: "double"
                                        },
                                        total_price: {
                                            bsonType: "double"
                                        }

                                    }
                                }
                                
                            }
                        }
                    },
                    $expr: {
                        $allElementsTrue: {
                            $map: {
                                input: "$detail",
                                in: {
                                    $eq: [
                                        "$$this.total_price",
                                        {$multiply: ["$$this.quantity", "$$this.price"]}
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
);